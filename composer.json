{
  "name": "croct/plug-storyblok",
  "description": "Serves Croct content inside Storyblok stories.",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "croct",
    "personalization",
    "storyblok",
    "cms",
    "php"
  ],
  "authors": [
    {
      "name": "Croct",
      "email": "lib+plug-storyblok@croct.com",
      "homepage": "https://croct.com"
    }
  ],
  "homepage": "https://github.com/croct-tech/plug-storyblok-php",
  "support": {
    "issues": "https://github.com/croct-tech/plug-storyblok-php/issues",
    "source": "https://github.com/croct-tech/plug-storyblok-php"
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "croct/plug-php": "0.1.0",
    "storyblok/php-content-api-client": "^1.18"
  },
  "require-dev": {
    "croct/coding-standard": "^0.4.5",
    "ergebnis/composer-normalize": "^2.28",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Croct\\Plug\\Storyblok\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Croct\\Plug\\Storyblok\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "test": [
      "composer validate",
      "composer normalize --dry-run",
      "mkdir -p .cache",
      "phpcs",
      "phpstan analyse --memory-limit=512M",
      "phpunit"
    ]
  }
}
